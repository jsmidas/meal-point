NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 사이트 주소 (결제 successUrl/failUrl 절대경로 생성에 사용)
NEXT_PUBLIC_SITE_URL=https://meal-point-ochre.vercel.app

# 토스페이먼츠 (개인결제)
# 테스트: test_ck_... / test_sk_...  운영: live_ck_... / live_sk_...
# 클라이언트 키만 브라우저에 노출, 시크릿 키는 서버 전용
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxx

# 소셜 로그인 (카카오) — 식단관리 체험 인증에 사용
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# 식단·급식관리 프로그램 외부 체험 사이트 URL (미설정 시 /trial에서 문의 안내로 대체)
NEXT_PUBLIC_MEAL_PLAN_TRIAL_URL=https://example-meal-plan.com/login

# 체험 사용권 자동 만료 Cron 인증 시크릿 (Vercel Cron이 Authorization 헤더로 전송)
CRON_SECRET=generate-a-random-secret-string

# (선택) 만료 시 외부 프로그램 게스트 데이터 초기화 웹훅
# MEAL_PLAN_RESET_WEBHOOK_URL=https://example-meal-plan.com/api/reset-guests
